# Postgres connection string, e.g. from Railway, Neon, or Supabase
DATABASE_URL=postgres://user:password@host:5432/dbname

# Password required to use the admin panel and admin API routes. Pick something private.
ADMIN_PASSWORD=change-me

# Restrict which website is allowed to call this API. Use * while testing, then
# lock it down to your deployed site's URL, e.g. https://mylegaue.netlify.app
ALLOWED_ORIGIN=*

# Set to "false" only if your Postgres host does not need SSL (most hosted ones do)
PGSSL=true

PORT=3000
